# Copy to an ignored per-instance .env file. Never commit real values.
COMPOSE_PROJECT_NAME=telegram-assist-example
TAB_INSTANCE_DIR=.
TAB_IMAGE=ghcr.io/hamedsanaei/telegram-assist-bot:1.1.2
TAB_RUNTIME_UID=10001
TAB_RUNTIME_GID=10001
TAB_MONGODB_IMAGE=mongo:7.0.32
TAB_MONGODB_DATABASE=telegram_assist_example
TAB_MONGODB_USERNAME=telegram_assist
TAB_MONGODB_PASSWORD=replace-locally
TAB_MONGODB_URI=mongodb://telegram_assist:replace-locally@mongodb:27017/?authSource=admin&directConnection=true
TAB_TELEGRAM_API_ID=replace-locally
TAB_TELEGRAM_API_HASH=replace-locally
TAB_TELEGRAM_PHONE_NUMBER=replace-locally
TAB_TELEGRAM_BOT_TOKEN=replace-locally
