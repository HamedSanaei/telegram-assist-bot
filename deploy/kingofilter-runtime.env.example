# Install as /etc/telegram-assist-kingofilter-runtime.env (root-owned, mode 0644).
# Non-secret coordinates only. Keep the release override that pins the verified
# image digest, and update this filename when deploying a new release override.
TAB_KINGOFILTER_INSTANCE_DIR=/opt/telegram-assist-bot/instances/admin1
TAB_KINGOFILTER_RELEASE_OVERRIDE=runtime-t103.override.yaml
